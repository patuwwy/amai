# AMAI PC Bridge - Configuration
# Copy this file to .env in the pc/ folder or project root.

# Server settings
BRIDGE_PORT=11435

# Default model to use if Amiga does not specify one
# For Google Gemini (FREE via AI Studio): gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro
# For OpenRouter: anthropic/claude-3.7-sonnet, google/gemini-2.5-flash, openai/gpt-4o
# For OpenAI: gpt-4o, gpt-4o-mini
# For Ollama (Local): qwen3.8:latest, llama3.2:latest
DEFAULT_MODEL=gemini-2.5-flash

# -------------------------------------------------------------
# Option 1: Google Gemini (Google AI Studio)
# -------------------------------------------------------------
# Get key: https://aistudio.google.com/app/apikey
#GEMINI_API_KEY=AQ...

# -------------------------------------------------------------
# Option 2: OpenRouter (All-in-one: Claude 3.7, GPT-4o, DeepSeek R1)
# -------------------------------------------------------------
# Get key: https://openrouter.ai/keys
#OPENROUTER_API_KEY=

# -------------------------------------------------------------
# Option 3: Official OpenAI
# -------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# -------------------------------------------------------------
# Option 4: Local Ollama
# -------------------------------------------------------------
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
