.key ARGS/F
.bra {
.ket }
Failat 21
If Not Exists src/amai.js
    If Exists amiga/src/amai.js
        cd amiga
    EndIf
EndIf

; 1. If compiled standalone binary exists in bin/amai, execute it directly
If Exists bin/amai
    bin/amai {ARGS}
Else
    ; 2. Otherwise run using NodeAmiga runtime from bin/
    If Exists bin/NodeAmiga
        bin/NodeAmiga src/amai.js {ARGS}
    Else
        NodeAmiga src/amai.js {ARGS}
    EndIf
EndIf
